{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-compaction-skill-restore",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "OpenCode server plugin that rewrites auto-compaction synthetic continue messages to remind the model to reload a previously loaded skill.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.17.13",
    "@opencode-ai/sdk": "1.17.13"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.8.2"
  }
}
